# Optional local-only project AWS profile.
# Copy this file to .envrc, adjust values, then run: direnv allow
# These paths keep personal AWS credentials scoped to this repo instead of ~/.aws.
export LOOP_PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export AWS_SHARED_CREDENTIALS_FILE="$LOOP_PROJECT_ROOT/.aws/credentials"
export AWS_CONFIG_FILE="$LOOP_PROJECT_ROOT/.aws/config"
export AWS_PROFILE=loop
export AWS_REGION=eu-central-1
export AWS_DEFAULT_REGION=eu-central-1
